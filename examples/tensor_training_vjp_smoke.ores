// Real Oreslang guest acceptance target. This source is NOT a compiled receipt.
// Run with the pinned compiler, this exact Git tree, and sibling atto-tensor.
import module Assert from "std/assert";
import class TensorF64 from "../../atto-tensor/src/tensor.ores";
import module TensorTrainingVjp from "../src/tensor_training_vjp.ores";

pub routine main(): void {
  val TensorF64 pre = new TensorF64(arr[1,3], arr[-2.0,0.0,3.0]);
  val TensorF64 saved = new TensorF64(arr[1,3], arr[0.0,0.0,3.0]);
  val TensorF64 upstream = new TensorF64(arr[1,3], arr[2.0,5.0,7.0]);
  val List<float> grad = arr[91.0,91.0,91.0];
  Assert.true_throws(TensorTrainingVjp.relu_vjp_f64_checked_into(rt borrow pre, rt borrow saved, rt borrow upstream, rt mut borrow grad).is_ok());
  Assert.true_throws(grad[0] == 0.0 && grad[1] == 0.0 && grad[2] == 7.0);

  val TensorF64 stale = new TensorF64(arr[1,3], arr[1.0,0.0,3.0]);
  Assert.true_throws(TensorTrainingVjp.relu_vjp_f64_checked_into(rt borrow pre, rt borrow stale, rt borrow upstream, rt mut borrow grad).is_err());
  Assert.true_throws(grad[0] == 0.0 && grad[1] == 0.0 && grad[2] == 7.0);

  val TensorF64 predictions = new TensorF64(arr[2], arr[3.0,5.0]);
  val TensorF64 targets = new TensorF64(arr[2], arr[1.0,1.0]);
  val List<float> loss_gradient = arr[-10.0,-10.0];
  Assert.true_throws(TensorTrainingVjp.mse_vjp_f64_checked_into(rt borrow predictions, rt borrow targets, rt mut borrow loss_gradient).is_ok());
  Assert.true_throws(loss_gradient[0] == 2.0 && loss_gradient[1] == 4.0);

  val TensorF64 mismatched = new TensorF64(arr[1,2], arr[1.0,1.0]);
  Assert.true_throws(TensorTrainingVjp.mse_vjp_f64_checked_into(
    rt borrow predictions, rt borrow mismatched, rt mut borrow loss_gradient
  ).is_err());
  Assert.true_throws(loss_gradient[0] == 2.0 && loss_gradient[1] == 4.0);

  val List<float> first = arr[2.0,3.0];
  val List<float> second = arr[4.0,5.0];
  val List<float> short = arr[2.0];
  val List<float> different = arr[3.0,4.0];
  val List<float> summed = arr[-9.0,-9.0];
  Assert.true_throws(TensorTrainingVjp.gradient_fanin_f64_checked_into(
    rt borrow first, rt borrow second, rt mut borrow summed
  ).is_ok());
  Assert.true_throws(summed[0] == 6.0 && summed[1] == 8.0);
  Assert.true_throws(TensorTrainingVjp.gradient_fanin_f64_checked_into(
    rt borrow short, rt borrow different, rt mut borrow summed
  ).is_err());
  Assert.true_throws(summed[0] == 6.0 && summed[1] == 8.0);
  stdio.println("ORES_AUTOGRAD_TENSOR_TRAINING_VJP_PASS");
}
