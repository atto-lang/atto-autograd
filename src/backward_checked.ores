import class TapeF64 from './tape';
import fnc backward_f64_into from './tape';

pub fnc backward_checked_into(
  TapeF64 tape,
  List<float> saved,
  int root,
  float seed,
  List<float> mut scratch,
  List<float> mut output
): Result<bool, String> {
  if scratch is output || scratch is saved || output is saved; do
    return Err("aliased gradient buffers");
  fi
  if scratch is tape.leaf_values || output is tape.leaf_values; do
    return Err("gradient alias with tape");
  fi
  let int n = 0;
  for const value of output do
    n = n + 1;
  done
  let int scratch_count = 0;
  for const value of scratch do
    scratch_count = scratch_count + 1;
  done
  if n != scratch_count; do
    return Err("gradient buffer length mismatch");
  fi
  if backward_f64_into(tape, saved, root, seed, scratch).is_err(); do
    return Err("backward failed");
  fi
  for const value of scratch do
    if (value - value) != 0.0; do
      return Err("nonfinite gradient; output unchanged");
    fi
  done
  for int i = 0; i < n; i++ do
    output[i] = scratch[i];
  done
  return Ok(true);
}
