import class TapeF64 from "./tape.ores";
import module TapeOps from "./tape.ores";

define module ForwardChecked as
  pub fnc forward_checked_into(
    borrow TapeF64 tape,
    borrow mut List<float> scratch,
    borrow mut List<float> output
  ): Result<bool, String> {
    if scratch is output || scratch is tape.leaf_values || output is tape.leaf_values; do
      return Err("aliased forward buffers");
    fi
    val int n = output.size;
    if n != scratch.size; do
      return Err("scratch length mismatch");
    fi
    if TapeOps.forward_f64_into(rt borrow tape, rt mut borrow scratch).is_err(); do
      return Err("forward failed");
    fi
    for int i = 0; i < n; i++ do
      output[i] = scratch[i];
    done
    return Ok(true);
  }
end
