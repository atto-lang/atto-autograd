// Native Oreslang tensor-valued VJP proof slice for broadcast add/multiply.
// Tensor algorithms live in .ores, not host-language ML frameworks.
// Caller-owned scratch/output references require compiler-proven unique loans
// before release; identity guards here do NOT prove transitive alias safety.
import class TensorF64 from "../../atto-tensor/src/tensor.ores";
import module TensorOps from "../../atto-tensor/src/tensor.ores";
import module Broadcast from "../../atto-tensor/src/broadcast.ores";
import module TensorGradients from "../../atto-tensor/src/gradients.ores";

define module TensorVjp as
  // VJP of z = left + right, with independently reduced gradients for one
  // caller-chosen operand. Exact shape contract checked before any publication.
  pub fnc add_operand_vjp_f64_checked_into(
    borrow TensorF64 left,
    borrow TensorF64 right,
    borrow TensorF64 upstream,
    bool with_respect_to_left,
    borrow mut List<float> reduction_scratch,
    borrow mut List<float> output
  ): Result<bool, String> {
    if TensorOps.validate_tensor(rt borrow upstream).is_err(); do
      return Err("invalid upstream add gradient");
    fi
    if Broadcast.validate_broadcast(rt borrow left, rt borrow right, rt borrow upstream.shape, upstream.values.size).is_err(); do
      return Err("forward broadcast contract mismatch");
    fi
    if reduction_scratch is left.values || reduction_scratch is right.values ||
       output is left.values || output is right.values; do
      return Err("gradient destination aliases forward tensor");
    fi
    if with_respect_to_left; do
      return TensorGradients.sum_to_shape_f64_checked_into(
        rt borrow upstream, rt borrow left.shape, rt mut borrow reduction_scratch, rt mut borrow output
      );
    fi
    return TensorGradients.sum_to_shape_f64_checked_into(
      rt borrow upstream, rt borrow right.shape, rt mut borrow reduction_scratch, rt mut borrow output
    );
  }

  // VJP of z = left * right:
  // dleft = sum_to_shape(upstream * right, left.shape)
  // dright = sum_to_shape(upstream * left, right.shape)
  // products and reduction_scratch MUST be distinct from all inputs/outputs.
  // The checked multiplication and reduction preflight protect output from
  // shape/nonfinite errors; scratch may be partially written on failure.
  pub fnc mul_operand_vjp_f64_checked_into(
    borrow TensorF64 left,
    borrow TensorF64 right,
    borrow TensorF64 upstream,
    bool with_respect_to_left,
    borrow mut List<float> products,
    borrow mut List<float> reduction_scratch,
    borrow mut List<float> output
  ): Result<bool, String> {
    if TensorOps.validate_tensor(rt borrow upstream).is_err(); do
      return Err("invalid upstream multiply gradient");
    fi
    val int n = upstream.values.size;
    if Broadcast.validate_broadcast(rt borrow left, rt borrow right, rt borrow upstream.shape, n).is_err(); do
      return Err("forward multiply broadcast mismatch");
    fi
    if products.size != n; do
      return Err("weighted-gradient product length mismatch");
    fi
    if products is reduction_scratch || products is output ||
       reduction_scratch is output; do
      return Err("multiply gradient scratch buffers overlap");
    fi
    if products is left.values || products is right.values ||
       products is upstream.values ||
       reduction_scratch is left.values || reduction_scratch is right.values ||
       output is left.values || output is right.values ||
       reduction_scratch is upstream.values || output is upstream.values; do
      return Err("multiply gradient destination aliases input");
    fi

    if with_respect_to_left; do
      if Broadcast.broadcast_mul_f64_into(
        rt borrow upstream, rt borrow right, rt borrow upstream.shape, rt mut borrow products
      ).is_err(); do
        return Err("invalid weighted left gradient");
      fi
      return TensorGradients.sum_values_to_shape_f64_checked_into(
        rt borrow upstream.shape, rt borrow products, rt borrow left.shape,
        rt mut borrow reduction_scratch, rt mut borrow output
      );
    fi
    if Broadcast.broadcast_mul_f64_into(
        rt borrow upstream, rt borrow left, rt borrow upstream.shape, rt mut borrow products
      ).is_err(); do
      return Err("invalid weighted right gradient");
    fi
    return TensorGradients.sum_values_to_shape_f64_checked_into(
      rt borrow upstream.shape, rt borrow products, rt borrow right.shape,
      rt mut borrow reduction_scratch, rt mut borrow output
    );
  }
end
